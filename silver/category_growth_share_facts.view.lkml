include: "/silver/explores/order_items.explore.lkml"

view: category_growth_share_facts {
  label: "Category Growth-Share Portfolio Facts"

  derived_table: {
    explore_source: order_items {
      column: department { field: products.department }
      column: category { field: products.category }
      column: active_skus { field: products.count }
      column: recent_era_revenue { field: order_items.recent_era_revenue }
      column: all_time_revenue { field: order_items.total_revenue }
      column: all_time_profit { field: inventory_items_order_items_fields.total_gross_profit }
      column: margin_rate { field: inventory_items_order_items_fields.gross_margin_ratio }
      column: return_rate { field: order_items.return_rate }
      filters: [
        products.id: "NOT NULL",
        orders.order_id: "NOT NULL",
        inventory_items.id: "NOT NULL"
      ]
      derived_column: recent_momentum_share {
        sql: SAFE_DIVIDE(recent_era_revenue, all_time_revenue) ;;
      }
      derived_column: dept_avg_revenue {
        sql: AVG(all_time_revenue) OVER (PARTITION BY department) ;;
      }
      derived_column: dept_avg_momentum_share {
        sql: AVG(SAFE_DIVIDE(recent_era_revenue, all_time_revenue)) OVER (PARTITION BY department) ;;
      }
    }
  }

  dimension: pk {
    primary_key: yes
    hidden: yes
    type: string
    sql: CONCAT(COALESCE(${department}, ''), ':', COALESCE(${category}, '')) ;;
  }

  dimension: department {
    label: "Product Department"
    group_label: "Category Portfolio Attributes"
    description: "Product department owning the clothing category."
    type: string
    sql: ${TABLE}.department ;;
  }

  dimension: category {
    label: "Product Category"
    group_label: "Category Portfolio Attributes"
    description: "Clothing category evaluated in the BCG growth-share portfolio matrix."
    type: string
    sql: ${TABLE}.category ;;
  }

  dimension: active_skus {
    label: "Category Active SKUs"
    group_label: "Category Portfolio Attributes"
    description: "Count of distinct sold product SKUs within the department and clothing category."
    type: number
    sql: ${TABLE}.active_skus ;;
  }

  dimension: recent_era_revenue {
    label: "Category Recent-Era Revenue (2025+)"
    group_label: "Category Portfolio Metrics"
    description: "Gross dollar sales generated by the department-category in calendar year 2025 or later."
    type: number
    value_format_name: usd
    sql: ${TABLE}.recent_era_revenue ;;
  }

  dimension: all_time_revenue {
    label: "Category All-Time Revenue"
    group_label: "Category Portfolio Metrics"
    description: "Cumulative all-time gross dollar sales generated by the department-category."
    type: number
    value_format_name: usd
    sql: ${TABLE}.all_time_revenue ;;
  }

  dimension: all_time_profit {
    label: "Category All-Time Gross Profit"
    group_label: "Category Portfolio Metrics"
    description: "Cumulative all-time gross dollar profit generated by the department-category."
    type: number
    value_format_name: usd
    sql: ${TABLE}.all_time_profit ;;
  }

  dimension: margin_rate {
    label: "Category Gross Margin Rate"
    group_label: "Category Portfolio Metrics"
    description: "Blended all-time gross profit margin ratio of the department-category."
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.margin_rate ;;
  }

  dimension: return_rate {
    label: "Category Return Rate"
    group_label: "Category Portfolio Metrics"
    description: "Share of ordered items in Returned status for the department-category."
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.return_rate ;;
  }

  dimension: recent_momentum_share {
    label: "Category Recent Momentum Share"
    group_label: "Category Portfolio Benchmarks"
    description: "Share of the category's cumulative revenue generated in calendar year 2025 or later."
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.recent_momentum_share ;;
  }

  dimension: dept_avg_revenue {
    label: "Department Average Category Revenue"
    group_label: "Category Portfolio Benchmarks"
    description: "Mean cumulative category revenue across all categories in the same department."
    type: number
    value_format_name: usd
    sql: ${TABLE}.dept_avg_revenue ;;
  }

  dimension: dept_avg_momentum_share {
    label: "Department Average Recent Momentum Share"
    group_label: "Category Portfolio Benchmarks"
    description: "Mean recent-era revenue momentum share across all categories in the same department."
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.dept_avg_momentum_share ;;
  }

  dimension: bcg_growth_share_quadrant {
    label: "Product Lifecycle Stage Growth-Share Taxonomy"
    description: "Product Lifecycle Stage Growth-Share Taxonomy places every clothing category into one of four classic portfolio quadrants—Superstars with high volume and strong recent momentum, mature Cash Cows, fast-surging Rising Question Marks, and lagging Sunset Dogs—by comparing recent sales momentum against historical department averages. Chief merchandising officers use this portfolio matrix to allocate seasonal buying budgets toward rising stars and reliable cash cows."
    synonyms: [
      "bcg matrix quadrant term",
      "product lifecycle stage growth-share taxonomy",
      "bcg growth share quadrant",
      "bcg portfolio quadrant"
    ]
    case: {
      when: {
        sql: ${all_time_revenue} >= ${dept_avg_revenue} AND ${recent_momentum_share} >= ${dept_avg_momentum_share} ;;
        label: "BCG Superstar (High Volume & High Recent Momentum)"
      }
      when: {
        sql: ${all_time_revenue} >= ${dept_avg_revenue} AND ${recent_momentum_share} < ${dept_avg_momentum_share} ;;
        label: "BCG Cash Cow (High Volume, Mature Steady Momentum)"
      }
      when: {
        sql: ${all_time_revenue} < ${dept_avg_revenue} AND ${recent_momentum_share} >= ${dept_avg_momentum_share} ;;
        label: "BCG Rising Question Mark (Niche Volume, Fast Recent Surge)"
      }
      else: "BCG Sunset Dog (Below-Average Volume & Momentum)"
    }
  }

  measure: count {
    label: "Categories in Quadrant"
    description: "Count of department-category pairs classified into the portfolio quadrant."
    synonyms: ["categories in quadrant", "quadrant category count"]
    type: count
  }

  measure: total_active_skus {
    label: "Total Active SKUs"
    description: "Sum of distinct sold SKUs across department-category pairs in the portfolio quadrant."
    synonyms: ["total skus", "quadrant skus"]
    type: sum
    sql: ${active_skus} ;;
  }

  measure: total_quadrant_revenue {
    label: "Quadrant Revenue"
    description: "Cumulative all-time gross dollar sales summed across categories in the portfolio quadrant."
    synonyms: ["quadrant revenue", "portfolio quadrant revenue"]
    type: sum
    value_format_name: usd
    sql: ${all_time_revenue} ;;
  }

  measure: total_quadrant_profit {
    label: "Quadrant Profit"
    description: "Cumulative all-time gross dollar profit summed across categories in the portfolio quadrant."
    synonyms: ["quadrant profit", "portfolio quadrant profit"]
    type: sum
    value_format_name: usd
    sql: ${all_time_profit} ;;
  }

  measure: avg_category_margin_rate {
    label: "Average Category Margin Rate"
    description: "Unweighted mean category gross margin ratio across categories in the portfolio quadrant."
    synonyms: ["avg margin ratio", "quadrant avg margin rate"]
    tags: ["non_additive"]
    type: average
    value_format_name: percent_2
    sql: ${margin_rate} ;;
  }

  measure: flagship_categories {
    label: "Flagship Categories (Top 5 by Revenue)"
    description: "Comma-separated top 5 department:category pairs in the portfolio quadrant ranked by all-time gross revenue."
    synonyms: ["flagship categories", "top quadrant categories"]
    tags: ["non_additive"]
    type: string
    sql: STRING_AGG(CONCAT(${department}, ':', ${category}), ', ' ORDER BY ${all_time_revenue} DESC LIMIT 5) ;;
  }
}
