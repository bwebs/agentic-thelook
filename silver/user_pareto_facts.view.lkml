include: "/silver/explores/users_sales_base.explore.lkml"

view: user_pareto_facts {
  label: "Customer Pareto Spend Concentration Facts"

  derived_table: {
    explore_source: users_sales_base {
      column: user_id { field: users.id }
      column: age { field: users.age }
      column: lifetime_spend { field: order_items.total_revenue }
      filters: [order_items.id: "NOT NULL"]
      derived_column: spend_decile {
        sql: NTILE(10) OVER (ORDER BY lifetime_spend DESC) ;;
      }
      derived_column: spend_pct_rank {
        sql: PERCENT_RANK() OVER (ORDER BY lifetime_spend DESC) ;;
      }
    }
  }

  dimension: user_id {
    primary_key: yes
    label: "Pareto-Evaluated Buyer User ID"
    description: "Unique customer identifier for paying customers evaluated in global Pareto spend tiers."
    type: number
    sql: ${TABLE}.user_id ;;
  }

  dimension: _age {
    hidden: yes
    type: number
    sql: ${TABLE}.age ;;
  }

  dimension: lifetime_spend {
    label: "Pareto Buyer Lifetime Spend"
    group_label: "Pareto Whale Concentration"
    description: "Cumulative gross dollar spend across all order items purchased by the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.lifetime_spend ;;
  }

  dimension: spend_decile {
    label: "Customer Lifetime Spend Decile"
    group_label: "Pareto Whale Concentration"
    description: "Pareto Whale Concentration decile (1 = top 10% highest-spending buyers down to 10 = bottom 10% buyers) dividing paying customers into ten equal spend tiers."
    synonyms: ["spend decile", "pareto spend decile", "customer ltv decile"]
    type: number
    sql: ${TABLE}.spend_decile ;;
  }

  dimension: spend_pct_rank {
    label: "Customer Lifetime Spend Percentile Rank"
    group_label: "Pareto Whale Concentration"
    description: "Relative percentile rank (0.00 = top spender to 1.00 = lowest spender) of the customer's cumulative lifetime spend across all paying buyers."
    synonyms: ["spend pct rank", "lifetime spend percentile rank"]
    type: number
    value_format_name: decimal_4
    sql: ${TABLE}.spend_pct_rank ;;
  }

  measure: count {
    label: "Pareto-Evaluated Buyers"
    description: "Number of distinct paying customers included in the Pareto spend breakdown."
    synonyms: ["customers in decile", "pareto buyers count"]
    type: count
    filters: [user_id: "NOT NULL"]
  }

  measure: min_lifetime_spend {
    label: "Minimum Customer Lifetime Spend"
    description: "Minimum cumulative lifetime dollar spend among paying customers in the selected group or decile."
    synonyms: ["min decile spend", "minimum buyer ltv"]
    tags: ["non_additive"]
    type: min
    value_format_name: usd
    sql: ${lifetime_spend} ;;
  }

  measure: max_lifetime_spend {
    label: "Maximum Customer Lifetime Spend"
    description: "Maximum cumulative lifetime dollar spend among paying customers in the selected group or decile."
    synonyms: ["max decile spend", "maximum buyer ltv"]
    tags: ["non_additive"]
    type: max
    value_format_name: usd
    sql: ${lifetime_spend} ;;
  }

  measure: total_lifetime_spend {
    label: "Total Decile Revenue"
    description: "Cumulative gross dollar revenue summed across paying customers in the selected group or decile."
    synonyms: ["decile revenue", "pareto buyer revenue"]
    type: sum
    value_format_name: usd
    sql: ${lifetime_spend} ;;
  }

  measure: _top_1_pct_buyer_spend {
    hidden: yes
    type: sum
    sql: ${lifetime_spend} ;;
    filters: [spend_pct_rank: "<=0.01"]
  }

  measure: _top_10_pct_buyer_spend {
    hidden: yes
    type: sum
    sql: ${lifetime_spend} ;;
    filters: [spend_pct_rank: "<=0.10"]
  }

  measure: _top_20_pct_buyer_spend {
    hidden: yes
    type: sum
    sql: ${lifetime_spend} ;;
    filters: [spend_pct_rank: "<=0.20"]
  }

  measure: top_1_pct_revenue_share {
    label: "Top 1% Whale Revenue Share"
    description: "Pareto Whale Concentration Coefficient share of cumulative company revenue generated by the top 1 percent of paying buyers (spend_pct_rank <= 0.01)."
    synonyms: ["top 1 pct revenue share", "top 1% buyer revenue share", "pareto top 1 percent share"]
    tags: ["non_additive"]
    type: number
    value_format_name: percent_2
    sql: 1.0 * ${_top_1_pct_buyer_spend} / NULLIF(${total_lifetime_spend}, 0) ;;
  }

  measure: top_10_pct_revenue_share {
    label: "Top 10% Whale Revenue Share"
    description: "Pareto Whale Concentration Coefficient share of cumulative company revenue generated by the top 10 percent of paying buyers (spend_pct_rank <= 0.10)."
    synonyms: ["top 10 pct revenue share", "top 10% buyer revenue share", "pareto top 10 percent share"]
    tags: ["non_additive"]
    type: number
    value_format_name: percent_2
    sql: 1.0 * ${_top_10_pct_buyer_spend} / NULLIF(${total_lifetime_spend}, 0) ;;
  }

  measure: top_20_pct_revenue_share {
    label: "Top 20% Whale Revenue Share"
    description: "Pareto Whale Concentration Coefficient share of cumulative company revenue generated by the top 20 percent of paying buyers (spend_pct_rank <= 0.20)."
    synonyms: ["top 20 pct revenue share", "top 20% buyer revenue share", "pareto whale concentration coefficient"]
    tags: ["non_additive"]
    type: number
    value_format_name: percent_2
    sql: 1.0 * ${_top_20_pct_buyer_spend} / NULLIF(${total_lifetime_spend}, 0) ;;
  }
}
