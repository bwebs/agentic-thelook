include: "/silver/explores/order_items.explore.lkml"

view: category_warehouse_chaos_facts {
  label: "Category-Warehouse Chaos Index Facts"

  derived_table: {
    explore_source: order_items {
      column: department { field: products.department }
      column: category { field: products.category }
      column: warehouse_name { field: distribution_centers.name }
      column: total_units { field: order_items.count }
      column: unique_buyers { field: order_items.distinct_users }
      column: distinct_brands { field: products.distinct_brands }
      column: avg_buyer_age { field: order_items_users_fields.avg_activity_weighted_user_age }
      column: gross_revenue { field: order_items.total_revenue }
      column: chaos_adjusted_net_profit { field: inventory_items_order_items_fields.chaos_adjusted_net_profit }
      column: loss_rate { field: order_items.reversal_loss_rate }
      column: avg_shelf_dwell_days { field: inventory_items_order_items_fields.avg_imputed_shelf_dwell_days }
      column: avg_fulfillment_hours { field: order_items.avg_imputed_fulfillment_hours }
      column: avg_shipment_km { field: distribution_centers_order_items_users_fields.avg_shipment_distance_km }
      filters: [
        orders.order_id: "NOT NULL",
        users.id: "NOT NULL",
        products.id: "NOT NULL",
        inventory_items.id: "NOT NULL",
        distribution_centers.id: "NOT NULL",
        order_items.count: ">=15"
      ]
      derived_column: profit_rank_in_dept {
        sql: DENSE_RANK() OVER (PARTITION BY department ORDER BY chaos_adjusted_net_profit DESC) ;;
      }
      derived_column: global_profit_percentile {
        sql: PERCENT_RANK() OVER (ORDER BY chaos_adjusted_net_profit DESC) ;;
      }
    }
  }

  dimension: pk {
    primary_key: yes
    hidden: yes
    type: string
    sql: CONCAT(COALESCE(${department}, ''), '|', COALESCE(${category}, ''), '|', COALESCE(${warehouse_name}, '')) ;;
  }

  dimension: department {
    label: "Department"
    description: "Product catalog department for the category-warehouse corridor."
    type: string
    sql: ${TABLE}.department ;;
  }

  dimension: category {
    label: "Product Category"
    description: "Product clothing category fulfilled through the warehouse corridor."
    type: string
    sql: ${TABLE}.category ;;
  }

  dimension: warehouse_name {
    label: "Fulfillment Warehouse"
    description: "Name of the physical distribution center fulfilling the category."
    type: string
    sql: ${TABLE}.warehouse_name ;;
  }

  dimension: total_units {
    label: "Corridor Units Fulfilled"
    description: "Total order item units fulfilled for the category-warehouse pair (filtered to pairs with 15+ units)."
    type: number
    sql: ${TABLE}.total_units ;;
  }

  dimension: unique_buyers {
    label: "Corridor Unique Buyers"
    description: "Distinct customers purchasing items in this category-warehouse pair."
    type: number
    sql: ${TABLE}.unique_buyers ;;
  }

  dimension: distinct_brands {
    label: "Corridor Distinct Brands"
    description: "Distinct catalog brands sold in this category-warehouse pair."
    type: number
    sql: ${TABLE}.distinct_brands ;;
  }

  dimension: avg_buyer_age {
    label: "Average Buyer Age (Item-Weighted)"
    description: "Mean customer age weighted across ordered items in the category-warehouse pair."
    type: number
    value_format_name: decimal_1
    sql: ${TABLE}.avg_buyer_age ;;
  }

  dimension: gross_revenue {
    label: "Corridor Gross Revenue"
    description: "Gross dollar sales generated by the category-warehouse pair."
    type: number
    value_format_name: usd
    sql: ${TABLE}.gross_revenue ;;
  }

  dimension: chaos_adjusted_net_profit {
    label: "Chaos-Adjusted Net Profit"
    description: "Net dollar profit for the category-warehouse pair after subtracting wholesale COGS on kept items and a 15% wholesale restocking loss on Returned or Cancelled items."
    type: number
    value_format_name: usd
    sql: ${TABLE}.chaos_adjusted_net_profit ;;
  }

  dimension: loss_rate {
    label: "Return or Cancellation Rate"
    description: "Share of ordered items in the category-warehouse pair lost to returns or cancellations."
    synonyms: ["return or cancel pct", "corridor loss rate"]
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.loss_rate ;;
  }

  dimension: avg_shelf_dwell_days {
    label: "Average Shelf Dwell Days"
    description: "Mean fractional days (imputing 30.0 days when unsold) items sat on warehouse shelves in this category-warehouse pair."
    type: number
    value_format_name: decimal_1
    sql: ${TABLE}.avg_shelf_dwell_days ;;
  }

  dimension: avg_fulfillment_hours {
    label: "Average Fulfillment Hours"
    description: "Mean imputed pick-pack plus carrier transit hours for the category-warehouse pair."
    type: number
    value_format_name: decimal_1
    sql: ${TABLE}.avg_fulfillment_hours ;;
  }

  dimension: avg_shipment_km {
    label: "Average Shipment Distance (km)"
    description: "Mean straight-line shipping distance in kilometers for the category-warehouse pair."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.avg_shipment_km ;;
  }

  dimension: grand_unified_chaos_singularity_score {
    label: "Omniscient Grand Unified Chaos Index"
    description: "The Omniscient Grand Unified Chaos Index combines chaos-adjusted net profit, log-scaled shipment distance, log-scaled fulfillment speed, and return/cancellation retention into a single profit efficiency score for every category and warehouse pair ((chaos_adjusted_net_profit / (LN(1 + avg_shipment_km) * LN(2 + avg_fulfillment_hours))) * (1 - loss_rate)). Executive leadership uses this master scorecard at quarterly business reviews to benchmark net value after operational friction."
    synonyms: [
      "grand unified chaos singularity score",
      "omniscient grand unified chaos index",
      "chaos singularity score"
    ]
    type: number
    value_format_name: decimal_2
    sql: (${chaos_adjusted_net_profit} / NULLIF(LN(1.0 + ${avg_shipment_km}) * LN(2.0 + ${avg_fulfillment_hours}), 0)) * (1.0 - ${loss_rate}) ;;
  }

  dimension: profit_rank_in_dept {
    label: "Profit Rank in Department"
    description: "Dense rank of the category-warehouse pair's chaos-adjusted net profit within its product department (1 = highest profit pair in department)."
    type: number
    sql: ${TABLE}.profit_rank_in_dept ;;
  }

  dimension: profit_percentile_rank {
    label: "Global Profit Percentile Rank"
    description: "Relative global percentile rank (0% = top profit corridor to 100% = lowest profit corridor) across qualified category-warehouse pairs."
    synonyms: ["global profit percentile", "profit percentile rank"]
    type: number
    value_format_name: percent_1
    sql: ${TABLE}.global_profit_percentile ;;
  }

  measure: count {
    label: "Qualified Category-Warehouse Pairs"
    description: "Count of category-warehouse corridors meeting the 15-unit minimum volume threshold."
    type: count
  }

  measure: total_corridor_chaos_profit {
    label: "Total Corridor Chaos-Adjusted Net Profit"
    description: "Sum of chaos-adjusted net profit across qualified category-warehouse corridors."
    type: sum
    value_format_name: usd
    sql: ${chaos_adjusted_net_profit} ;;
  }

  measure: avg_chaos_singularity_score {
    label: "Average Chaos Singularity Score"
    description: "Mean Omniscient Grand Unified Chaos Index score across qualified category-warehouse corridors."
    tags: ["non_additive"]
    type: average
    value_format_name: decimal_2
    sql: ${grand_unified_chaos_singularity_score} ;;
  }
}
