include: "/silver/explores/order_items.explore.lkml"

view: warehouse_fulfillment_facts {
  label: "Warehouse Fulfillment Physics & P&L Facts"

  derived_table: {
    explore_source: order_items {
      column: dc_id { field: distribution_centers.id }
      column: fulfilled_order_items { field: order_items.count }
      column: distinct_orders_touched { field: order_items.distinct_orders }
      column: gross_revenue { field: order_items.total_revenue }
      column: retained_net_profit { field: inventory_items_order_items_fields.retained_net_profit }
      column: returned_units { field: order_items.returned_items }
      column: avg_pick_pack_hours { field: order_items.avg_warehouse_procrastination_hours }
      column: avg_carrier_transit_hours { field: order_items.avg_truck_transit_hours }
      column: total_shipment_km { field: distribution_centers_order_items_users_fields.total_shipment_distance_km }
      filters: [
        orders.order_id: "NOT NULL",
        inventory_items.id: "NOT NULL",
        distribution_centers.id: "NOT NULL",
        users.id: "NOT NULL"
      ]
    }
  }

  dimension: dc_id {
    primary_key: yes
    label: "Active Fulfillment Warehouse ID"
    description: "Unique distribution center identifier for warehouses with outbound fulfilled orders."
    type: number
    sql: ${TABLE}.dc_id ;;
  }

  dimension: fulfilled_order_items {
    label: "Warehouse Fulfilled Order Items"
    description: "Total order line items fulfilled out of the distribution center."
    type: number
    sql: ${TABLE}.fulfilled_order_items ;;
  }

  dimension: distinct_orders_touched {
    label: "Warehouse Distinct Orders Touched"
    description: "Distinct customer orders fulfilled at least in part by the distribution center."
    type: number
    sql: ${TABLE}.distinct_orders_touched ;;
  }

  dimension: gross_revenue {
    label: "Warehouse Gross Revenue"
    description: "Gross dollar sales fulfilled out of the distribution center."
    type: number
    value_format_name: usd
    sql: ${TABLE}.gross_revenue ;;
  }

  dimension: retained_net_profit {
    label: "Warehouse Retained Net Profit"
    description: "Retained net dollar profit (excluding Cancelled and Returned items) generated by the distribution center."
    type: number
    value_format_name: usd
    sql: ${TABLE}.retained_net_profit ;;
  }

  dimension: returned_units {
    label: "Warehouse Returned Units"
    description: "Returned order line items fulfilled out of the distribution center."
    type: number
    sql: ${TABLE}.returned_units ;;
  }

  dimension: avg_pick_pack_hours {
    label: "Warehouse Pick-and-Pack Hours"
    description: "Mean integer hours from order creation to carrier handoff in the distribution center."
    type: number
    value_format_name: decimal_1
    sql: ${TABLE}.avg_pick_pack_hours ;;
  }

  dimension: avg_carrier_transit_hours {
    label: "Warehouse Carrier Transit Hours"
    description: "Mean integer hours from carrier handoff to customer delivery for shipments from the distribution center."
    type: number
    value_format_name: decimal_1
    sql: ${TABLE}.avg_carrier_transit_hours ;;
  }

  dimension: total_shipment_km {
    label: "Warehouse Total Shipment Kilometers"
    description: "Cumulative straight-line shipping kilometers traveled by items fulfilled from the distribution center."
    type: number
    value_format_name: decimal_1
    sql: ${TABLE}.total_shipment_km ;;
  }

  measure: count {
    label: "Active Fulfillment Warehouses"
    description: "Number of distribution centers with fulfilled outbound orders."
    type: count
    filters: [dc_id: "NOT NULL"]
  }

  measure: total_fulfilled_order_items {
    label: "Fulfilled Order Items"
    description: "Total outbound order line items fulfilled across distribution centers."
    synonyms: ["fulfilled order items"]
    type: sum
    sql: ${fulfilled_order_items} ;;
  }

  measure: total_gross_revenue {
    label: "Outbound Gross Revenue"
    description: "Total outbound gross dollar sales across distribution centers."
    synonyms: ["warehouse gross revenue"]
    type: sum
    value_format_name: usd
    sql: ${gross_revenue} ;;
  }

  measure: total_retained_net_profit {
    label: "Outbound Retained Net Profit"
    description: "Total retained net dollar profit (excluding Returned and Cancelled items) across distribution centers."
    synonyms: ["warehouse retained net profit"]
    type: sum
    value_format_name: usd
    sql: ${retained_net_profit} ;;
  }

  measure: total_returned_units {
    hidden: yes
    type: sum
    sql: ${returned_units} ;;
  }

  measure: total_outbound_shipment_km {
    hidden: yes
    type: sum
    sql: ${total_shipment_km} ;;
  }

  measure: return_drag_rate {
    label: "Warehouse Return Drag Rate"
    description: "Share of fulfilled outbound order items returned by customers (returned_units / fulfilled_order_items)."
    synonyms: ["return drag pct", "return drag rate", "warehouse return rate"]
    tags: ["non_additive"]
    type: number
    value_format_name: percent_2
    sql: 1.0 * ${total_returned_units} / NULLIF(${total_fulfilled_order_items}, 0) ;;
  }

  measure: avg_warehouse_pick_pack_hours {
    label: "Average Pick-and-Pack Hours"
    description: "Mean warehouse pick-and-pack hours across evaluated fulfillment centers."
    synonyms: ["avg pick pack hrs", "avg pick pack hours"]
    tags: ["non_additive"]
    type: average
    value_format_name: decimal_1
    sql: ${avg_pick_pack_hours} ;;
  }

  measure: net_profit_per_1000_shipment_km {
    label: "Net Profit per 1,000 Shipment km"
    description: "Warehouse Gravity Well and Supply Chain Profit Efficiency benchmark: retained net dollar profit earned per thousand kilometers shipped (1000 * retained_net_profit / total_shipment_km)."
    synonyms: ["net profit per 1000 shipment km", "warehouse gravity well profit efficiency", "supply chain profit efficiency"]
    tags: ["non_additive"]
    type: number
    value_format_name: decimal_4
    sql: 1000.0 * ${total_retained_net_profit} / NULLIF(${total_outbound_shipment_km}, 0) ;;
  }
}
