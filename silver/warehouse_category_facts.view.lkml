include: "/silver/explores/order_items.explore.lkml"

view: warehouse_category_facts {
  label: "Warehouse Category Specialty Facts"

  derived_table: {
    explore_source: order_items {
      column: dc_id { field: distribution_centers.id }
      column: product_category { field: inventory_items.product_category }
      column: sold_units { field: order_items.count }
      column: category_revenue { field: order_items.total_revenue }
      filters: [
        distribution_centers.id: "NOT NULL",
        inventory_items.id: "NOT NULL"
      ]
      derived_column: cat_rank_in_dc {
        sql: RANK() OVER (PARTITION BY dc_id ORDER BY sold_units DESC, category_revenue DESC) ;;
      }
    }
  }

  dimension: pk {
    primary_key: yes
    hidden: yes
    type: string
    sql: CONCAT(CAST(${dc_id} AS STRING), '_', COALESCE(${product_category}, '')) ;;
  }

  dimension: dc_id {
    label: "Distribution Center ID"
    description: "Identifier of the fulfillment center where the product category volume is ranked."
    tags: ["foreign_key"]
    type: number
    sql: ${TABLE}.dc_id ;;
  }

  dimension: product_category {
    label: "Warehouse Product Category"
    description: "Clothing category stocked and shipped out of the fulfillment center."
    synonyms: ["dc product category", "warehouse category"]
    type: string
    sql: ${TABLE}.product_category ;;
  }

  dimension: sold_units {
    label: "Category Sold Units in Warehouse"
    description: "Outbound order item units sold for this clothing category within the fulfillment center."
    type: number
    sql: ${TABLE}.sold_units ;;
  }

  dimension: category_revenue {
    label: "Category Revenue in Warehouse"
    description: "Gross outbound revenue generated by this clothing category within the fulfillment center."
    type: number
    value_format_name: usd
    sql: ${TABLE}.category_revenue ;;
  }

  dimension: cat_rank_in_dc {
    label: "Category Rank in Warehouse"
    description: "Rank of the clothing category inside the fulfillment center ordered by outbound units sold and gross revenue."
    synonyms: ["category rank in dc", "warehouse category rank"]
    type: number
    sql: ${TABLE}.cat_rank_in_dc ;;
  }

  dimension: warehouse_specialty_tier {
    label: "Warehouse Specialty Monopoly Tag"
    description: "Warehouse Specialty Monopoly Tag ranks the top-selling clothing categories inside each fulfillment center to crown every warehouse's number-one Flagship Signature Category, alongside its Core Podium Specialties, Standard Supporting Categories, and Long-Tail Side-Hustle Stock. Regional inventory planners use this specialty breakdown to see which product lines dominate each warehouse's daily outbound volume."
    synonyms: ["warehouse specialty tier", "warehouse specialty monopoly tag", "fulfillment center specialty tier", "warehouse category specialty"]
    case: {
      when: {
        sql: ${cat_rank_in_dc} = 1 ;;
        label: "Flagship Signature Crown Category (#1)"
      }
      when: {
        sql: ${cat_rank_in_dc} <= 3 ;;
        label: "Core Podium Specialty (#2-#3)"
      }
      when: {
        sql: ${cat_rank_in_dc} <= 10 ;;
        label: "Standard Supporting Category (#4-#10)"
      }
      else: "Long-Tail Side-Hustle Stock (#11+)"
    }
  }

  measure: count {
    label: "Categories in Specialty Tier"
    description: "Number of warehouse product categories falling into the specialty tier."
    synonyms: ["categories in tier", "warehouse category count"]
    type: count
  }

  measure: total_sold_units {
    label: "Specialty Tier Units Sold"
    description: "Total outbound units sold across warehouse product categories in the specialty tier."
    synonyms: ["specialty units sold", "tier units sold"]
    type: sum
    sql: ${sold_units} ;;
  }

  measure: total_category_revenue {
    label: "Specialty Tier Revenue"
    description: "Total gross outbound revenue across warehouse product categories in the specialty tier."
    synonyms: ["tier revenue", "specialty tier revenue"]
    type: sum
    sql: ${category_revenue} ;;
    value_format_name: usd
  }

  measure: top_signature_categories {
    label: "Top Signature Categories"
    description: "Comma-separated list of top-two ranked signature clothing categories (rank #1 and #2) inside the fulfillment center ordered by rank."
    synonyms: ["signature categories", "flagship categories list"]
    tags: ["non_additive"]
    type: string
    sql: STRING_AGG(CASE WHEN ${cat_rank_in_dc} <= 2 THEN ${product_category} END, ', ' ORDER BY ${cat_rank_in_dc}) ;;
  }
}
