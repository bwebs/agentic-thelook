include: "/silver/explores/order_items.explore.lkml"

view: user_brand_facts {
  label: "Customer Brand Affinity Facts"

  derived_table: {
    explore_source: order_items {
      column: user_id { field: order_items.user_id }
      column: brand { field: products.brand }
      column: brand_items { field: order_items.count }
      column: brand_spend { field: order_items.total_revenue }
      column: brand_profit { field: inventory_items_order_items_fields.total_gross_profit }
      filters: [
        order_items.user_id: "NOT NULL",
        products.id: "NOT NULL",
        inventory_items.id: "NOT NULL"
      ]
      derived_column: brand_entropy_component {
        sql: -1.0 * (1.0 * brand_items / SUM(brand_items) OVER (PARTITION BY user_id)) * LN(1.0 * brand_items / SUM(brand_items) OVER (PARTITION BY user_id)) ;;
      }
    }
  }

  dimension: pk {
    primary_key: yes
    hidden: yes
    type: string
    sql: CONCAT(CAST(${user_id} AS STRING), ':', COALESCE(${brand}, '__NULL__')) ;;
  }

  dimension: user_id {
    label: "Brand Buyer User ID"
    description: "Unique customer identifier for a buyer of this product brand."
    type: number
    sql: ${TABLE}.user_id ;;
  }

  dimension: brand {
    label: "Brand"
    description: "Product brand purchased by the customer."
    type: string
    sql: ${TABLE}.brand ;;
  }

  dimension: brand_items {
    label: "Customer Brand Units Bought"
    description: "Cumulative number of order line items of this specific brand purchased by the customer."
    synonyms: ["items of this brand", "customer brand items"]
    type: number
    sql: ${TABLE}.brand_items ;;
  }

  dimension: is_repeat_brand_buyer {
    label: "Repeat Brand Devotee (2+ Units)"
    description: "Whether the customer has purchased two or more items from this specific fashion brand."
    synonyms: ["is repeat brand buyer", "repeat brand devotee"]
    type: yesno
    sql: ${brand_items} >= 2 ;;
  }

  dimension: brand_spend {
    label: "Customer Brand Spend"
    description: "Cumulative gross dollar sales spent by the customer on this brand."
    type: number
    value_format_name: usd
    sql: ${TABLE}.brand_spend ;;
  }

  dimension: brand_profit {
    label: "Customer Brand Gross Profit"
    description: "Cumulative gross dollar profit generated by the customer's purchases of this brand."
    type: number
    value_format_name: usd
    sql: ${TABLE}.brand_profit ;;
  }

  dimension: _brand_entropy_component {
    hidden: yes
    type: number
    sql: ${TABLE}.brand_entropy_component ;;
  }

  measure: count {
    label: "Distinct Brand Buyers"
    description: "Total distinct customers who have purchased at least one item from the brand."
    synonyms: ["total distinct buyers", "brand buyers count"]
    type: count
    filters: [user_id: "NOT NULL"]
  }

  measure: _brand_count {
    hidden: yes
    type: count
    filters: [brand: "-NULL"]
  }

  measure: repeat_brand_devotees {
    label: "Repeat Brand Devotees (2+ Units)"
    description: "Number of distinct customers who purchased two or more items from the same fashion brand."
    synonyms: ["repeat brand devotees", "repeat brand buyers"]
    type: count
    filters: [user_id: "NOT NULL", is_repeat_brand_buyer: "yes"]
  }

  measure: cult_devotion_repeat_rate {
    label: "Cult Devotion Brand Repeat Rate"
    description: "Share of a brand's distinct buyers who come back to buy two or more items from that same fashion label (repeat_brand_devotees / count)."
    synonyms: ["cult devotion repeat rate", "cult devotion repeat rate pct", "brand repeat buyer share"]
    tags: ["non_additive"]
    type: number
    value_format_name: percent_2
    sql: 1.0 * ${repeat_brand_devotees} / NULLIF(${count}, 0) ;;
  }

  measure: max_units_by_single_buyer {
    label: "Max Brand Units Hoarded by One Buyer"
    description: "Maximum number of items from a single brand purchased by any one customer."
    synonyms: ["max units hoarded by one fan", "max brand units per buyer"]
    tags: ["non_additive"]
    type: max
    sql: ${brand_items} ;;
  }

  measure: _total_brand_items {
    hidden: yes
    type: sum
    sql: ${brand_items} ;;
  }

  measure: _total_brand_spend {
    hidden: yes
    type: sum
    sql: ${brand_spend} ;;
  }

  measure: _total_brand_profit {
    hidden: yes
    type: sum
    sql: ${brand_profit} ;;
  }

  measure: _sum_brand_entropy {
    hidden: yes
    type: sum
    sql: ${_brand_entropy_component} ;;
  }
}
